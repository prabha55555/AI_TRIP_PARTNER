# Copy to .env.local and fill in. Never commit .env.local.
# Optional. Only used if VITE_USE_GOOGLE_PLACES=true (requires Google Cloud billing).
VITE_GOOGLE_PLACES_API_KEY=
VITE_USE_GOOGLE_PLACES=false
VITE_GOOGLE_AUTH_CLIENT_ID=
# Optional in production: address of the backend if it is hosted on a different site (leave empty in dev).
VITE_API_URL=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ---- Backend (server/). These are read by Node only and are NEVER sent to the browser. ----
GEMINI_API_KEY=
# Optional: pin a Gemini model. Default is a fallback chain (see server/gemini.js).
GEMINI_MODEL=
# Must match VITE_GOOGLE_AUTH_CLIENT_ID so only tokens issued to this app are accepted.
GOOGLE_CLIENT_ID=
# Production: the website allowed to call the API, e.g. https://travelbeam.vercel.app
ALLOWED_ORIGIN=
PORT=8787
TRIPS_PER_HOUR=10
