# Copy to .env.local and fill in. Never commit .env.local.
# Optional. Only used if VITE_USE_GOOGLE_PLACES=true (requires Google Cloud billing).
VITE_GOOGLE_PLACES_API_KEY=
VITE_USE_GOOGLE_PLACES=false
VITE_GOOGLE_GEMINI_AI_API_KEY=
# Optional: pin a Gemini model. Default is a fallback chain (see src/AI/AIModel.jsx).
VITE_GEMINI_MODEL=
VITE_GOOGLE_AUTH_CLIENT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
